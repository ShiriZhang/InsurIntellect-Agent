# Local Python embeddings and independent generation API
# Copy this file to .env and set your local model revision and generation credentials.
# Never commit real keys.

HOST=127.0.0.1
PORT=8766
DEBUG=true

# Generation only: set your provider, model ID and key.
GENERATION_API_BASE_URL=https://generation-provider.example/v1
GENERATION_API_KEY=
GENERATION_MODEL=your-generation-model
OPENAI_TIMEOUT_SECS=90

# Local Python embeddings; BGE-M3 is an evaluation candidate, not a validated release profile.
# Pin a model commit/revision before use. Empty revision means local embedding is not configured.
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_REVISION=
LOCAL_EMBEDDING_CACHE_DIR=./data/models
LOCAL_EMBEDDING_DEVICE=auto
LOCAL_EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_MAX_BATCH_RETRIES=3
# Exact tokenizer budget includes role prefixes and special tokens; actual model limit may be lower.
LOCAL_EMBEDDING_MAX_INPUT_TOKENS=512
LOCAL_EMBEDDING_TEXT_NORMALIZATION=preserve
# Prefix whitespace matters. Quote a trailing space if using query:/passage: prefixes.
LOCAL_EMBEDDING_QUERY_PREFIX=""
LOCAL_EMBEDDING_DOCUMENT_PREFIX=""
LOCAL_EMBEDDING_NORMALIZE=true
EMBEDDING_DISTANCE=cosine
# Runtime loads cached assets only. Explicit first preparation: python -m scripts.prepare_models --download
# Optional generation connectivity request: add --check-generation (may cost tokens).
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=0.25
LLM_BACKOFF_FACTOR=2
LLM_BACKOFF_MAX=2.5
SIMILARITY_THRESHOLD=0.32

# Legacy generation aliases, used only when the corresponding GENERATION_* is UNSET:
# URL: OPENAI_BASE_URL > SILICONFLOW_BASE_URL
# key: OPENAI_API_KEY > SILICONFLOW_API_KEY
# core model: OPENAI_MODEL_CORE > OPENAI_MODEL > SILICONFLOW_MODEL
# light model: OPENAI_MODEL_LIGHT > OPENAI_MODEL > SILICONFLOW_MODEL
# Explicit empty GENERATION_* disables that value instead of falling back.
# GENERATION_MODEL overrides both legacy model roles.
# OPENAI_EMBEDDING_MODEL / EMBEDDING_MODEL are ignored; no remote/hash fallback.
# See docs/model-configuration.md for data boundaries and task coverage.

# Main-path defaults
SIMPLE_RAG_MODE=true
ENABLE_QUERY_REWRITING=false
ENABLE_QUERY_ROUTING=false
CONTEXT_BUILD_TIMEOUT_SECS=20
LLM_ANSWER_TIMEOUT_SECS=60
LLM_QUEUE_TIMEOUT_SECS=5

# Chroma / telemetry
CHROMA_ANONYMIZED_TELEMETRY=false
CHROMA_DISABLE_TELEMETRY=1
CHROMA_PERSIST_DIRECTORY=./data/vector_db/chroma
PROCESSED_DATA_PATH=./data/processed
PDF_STORAGE_PATH=./data/documents/pdfs
UPLOAD_MAX_BYTES=20971520

# Local SQLite. Leave DATABASE_URL_ASYNC empty unless you need async SQLAlchemy.
DATABASE_URL=sqlite:///./data/database/app.db
DATABASE_URL_ASYNC=
